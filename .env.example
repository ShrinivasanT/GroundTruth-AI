# ── Application ─────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=storage

# ── Milvus Vector Database ──────────────────────────────────────────────
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=root:Milvus

# ── Embedding Model (FastEmbed) ─────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# ── OpenAI (LangGraph agents & final answer generation) ─────────────────
# Required for the agent pipeline (Phases 3-5).
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5-nano
OPENAI_CHAT_MODEL=gpt-5-mini

# ── Refetch Agent ───────────────────────────────────────────────────────
REFETCH_RELEVANCE_THRESHOLD=0.65
REFETCH_PAPER_LIMIT=2

# ── Legacy (optional, kept for backward compatibility) ──────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_KEYWORD_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── HuggingFace Papers Search (public, no key needed) ───────────────
HUGGINGFACE_PAPERS_API_URL=https://huggingface.co/api/papers/search

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=FactChat
